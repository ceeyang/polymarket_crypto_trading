# Key-related secrets only
PRIVATE_KEY=
FUNDER_ADDRESS=

# CLOB L2 API keys (optional; empty means derive from PRIVATE_KEY)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# CLOB签名类型：0=EOA钱包, 1=邮箱账号(polyProxy), 2=Gnosis Safe（默认2）
SIGNATURE_TYPE=2

# Builder/Relayer keys (required for `pnpm run claim`)
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# Relayer交易类型：可填 0/1/2 或 PROXY/SAFE（默认2=>SAFE）
RELAYER_TX_TYPE=SAFE