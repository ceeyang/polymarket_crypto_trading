# Trading / wallet
PRIVATE_KEY=
FUNDER_ADDRESS=

# Polymarket CLOB L2 API keys (optional; empty means derive from PRIVATE_KEY)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# CLOB 签名类型：0=EOA, 1=polyProxy, 2=Gnosis Safe（默认2）
SIGNATURE_TYPE=2

# Builder / Relayer keys（claim 需要）
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# Relayer 交易类型：0/1/2 或 PROXY/SAFE
RELAYER_TX_TYPE=SAFE

# AI model（单模型，默认 DeepSeek）
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_API_TYPE=openai_chat_compatible
AI_LABEL=DeepSeek Primary
AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_MS=30000
AI_RESPONSE_MODE=json_object
