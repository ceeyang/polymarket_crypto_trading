# Trading / wallet
# 当前版本不再需要任何 AI / 模型相关环境变量。
PRIVATE_KEY=
FUNDER_ADDRESS=
WEB_PASSWORD=
# 可选：Web 登录会话时长，默认 12 小时（毫秒）
# WEB_SESSION_TTL_MS=43200000
# 可选：如果你走 HTTPS 反代，可开启 Secure Cookie
# WEB_SECURE_COOKIE=true

# Polymarket CLOB L2 API keys (optional; empty means derive from PRIVATE_KEY)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# CLOB 签名类型：0=EOA, 1=polyProxy, 2=Gnosis Safe（默认2）
SIGNATURE_TYPE=2

# Builder / Relayer keys（claim 需要）
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# Relayer 交易类型：0/1/2 或 PROXY/SAFE
RELAYER_TX_TYPE=SAFE
